# 构建产物 / 运行产物
dist/
*.tipa
*.err
*.log

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 依赖与运行时数据（不入库）
trollvnc-farm/node_modules/
trollvnc-farm/data/
trollvnc-farm/frp/

# 本地工作数据：改动前备份与网关运行日志（频繁变化且体积增长，不入库）
data/backups/
data/gateway.log

# 技能卡 / 做法表 / trace（AI 操作层的【运行时数据】，由执行过程自动产生，
# 会随每次执行变化 → 不入库。资产格式规范住在 skills/superphone-device/SKILL.md + 架构总纲 §7.1）
data/skill-cards/
data/traces/

# 上游对照副本 / 打包产物 / 截图
TrollVNC-upstream/
*.zip
*.png
# 截图与其他图像产物（2026-09-19 补：原只写 *.png，导致 *.jpg 测试截图被
# `git add -A` 误提交并污染远程树 —— 详见 docs/known-issues/04-发布与推送.md 首条）
*.jpg
*.jpeg
*.webp

# Python 字节码（临时脚本跑出来就会生成，不该入库）
__pycache__/
*.pyc

# 一次性执行产物目录（脚本跑任务落盘的截图/时间线；测试用，不入库）
ma35_task/

# TrollVNC 旧 git 对象库（已归档，不入库）
TrollVNC/.git.bak/

# 隔离 worktree 目录（本地开发用）
.worktrees/

# 外部开源项目参考代码（拉取深研用，不入库）
_research/

# CI 取包本地解压残留（_tipa_extract/_zip_extract/_tmp-insp 等，一次性产物不入库）
_tipa_extract/
_zip_extract/
_tmp-insp/
# 部署临时目录（tipa 解包/设备端推送的中间产物，含 node_modules，体积大且一次性）
_deploy-tmp/
packages-bootstrap.zip
packages-rootless.zip
packages-default.zip
packages-roothide.zip
