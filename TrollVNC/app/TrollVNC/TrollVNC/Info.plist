<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- §2.3m https 化：网关控制台改 https（自签证书，无感剪贴板依赖）。WKWebView 与 URLSession 均已用
		     challenge 处理信任自签 serverTrust；NSAllowsArbitraryLoads 兜底确保 ATS 不预拦（内网可信边界，宪法 1.3）。
		     设备端 5801 直连页仍为 http 明文，同样依赖该豁免。 -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_rfb._tcp</string>
		<string>_http._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SuperPhone uses the local network to advertise and accept VNC connections from clients on your LAN.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SuperPhone 使用定位显示当前位置（未模拟定位时展示真实位置；模拟定位时展示模拟位置）。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SuperPhone saves uploaded photos/videos to the device photo library (album.import).</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- 2026-09-18 补 fetch：TVNCServiceCoordinator 用 BGAppRefreshTask（identifier
	     com.82flex.trollvnc.refresh）做「App 挂起期间的保活兜底」，而 BGAppRefreshTask
	     要求 UIBackgroundModes 含 fetch —— 此前只有 network-authentication（那是网络认证用的，
	     与后台刷新无关），导致 registerForTaskWithIdentifier 注册的刷新任务【从未被系统调度】。
	     后果：App 一旦挂起，3s NSTimer 探活即停（见 TVNCServiceCoordinator.m L158），
	     manager 若在此时被回收（实测：挂在 SSH 的 coalition 下被连带终止，bug_type 309）
	     就再无人拉起，整条 manager→server 链断死，必须人工点开 App。
	     network-authentication 保持原样（另有用途），此处为追加而非替换。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>network-authentication</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.82flex.trollvnc.refresh</string>
	</array>
</dict>
</plist>
